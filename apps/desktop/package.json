{
  "name": "@tescord/desktop",
  "version": "0.3.2",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "build:native": "node scripts/build-rnnoise.mjs && node scripts/build-loopback.mjs",
    "build:sqlite": "electron-builder install-app-deps",
    "build": "node ../../scripts/generate-build-config.mjs && pnpm run build:native && pnpm run build:sqlite && tsc && pnpm run copy-assets",
    "start": "electron .",
    "dev": "node ../../scripts/build-desktop-web.mjs && pnpm run build && electron .",
    "dist": "node ../../scripts/build-desktop-web.mjs && pnpm run build && electron-builder",
    "dist:win": "node ../../scripts/build-desktop-web.mjs && pnpm run build && electron-builder --win",
    "dist:mac": "node ../../scripts/build-desktop-web.mjs && pnpm run build && electron-builder --mac"
  },
  "dependencies": {
    "@tescord/types": "workspace:*",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "12.11.1",
    "onnxruntime-node": "1.22.0"
  },
  "devDependencies": {
    "@shiguredo/rnnoise-wasm": "2022.2.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "electron": "41.10.6",
    "electron-builder": "^26.15.3",
    "node-gyp": "11.5.0",
    "typescript": "^5.8.2"
  },
  "build": {
    "appId": "com.tescord.desktop",
    "productName": "Tescord",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/audio/*.node",
      "**/better-sqlite3/build/Release/*.node"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Tescord-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "resources/icon.png",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Tescord captures system audio when you share your screen with audio.",
        "NSMicrophoneUsageDescription": "Tescord uses your microphone for voice channels and calls.",
        "NSCameraUsageDescription": "Tescord uses your camera for video channels and calls."
      },
      "extraResources": [
        {
          "from": "resources/mac-locales",
          "to": ".",
          "filter": [
            "**/*.lproj/InfoPlist.strings"
          ]
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking"
    }
  }
}
