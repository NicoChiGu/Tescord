{
  "name": "@tescord/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "build:native": "node scripts/build-rnnoise.mjs",
    "build:sqlite": "electron-builder install-app-deps",
    "build": "node ../../scripts/generate-build-config.mjs && pnpm run build:native && pnpm run build:sqlite && tsc && pnpm run copy-assets",
    "start": "electron .",
    "dev": "pnpm run build && electron .",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac"
  },
  "dependencies": {
    "@tescord/types": "workspace:*",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^12.6.0",
    "onnxruntime-node": "1.22.0"
  },
  "devDependencies": {
    "@shiguredo/rnnoise-wasm": "2022.2.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "node-gyp": "11.5.0",
    "typescript": "^5.8.2"
  },
  "build": {
    "appId": "com.tescord.desktop",
    "productName": "Tescord",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/audio/*.node",
      "**/better-sqlite3/build/Release/*.node"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.social-networking"
    }
  }
}
