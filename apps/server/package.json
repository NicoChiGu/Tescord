{
  "name": "@tescord/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "tsx scripts/prisma.ts generate",
    "db:push": "tsx scripts/prisma.ts db push --skip-generate",
