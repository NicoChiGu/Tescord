# Copy to docker/.env.cloudflare on the target host; chmod 600. Never commit actual tokens.
SITE_HOST=tescord.terata.top
DATABASE_URL=postgresql://tescord:REPLACE_POSTGRES_PASSWORD@postgres:5432/tescord
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_LONG_RANDOM_VALUE
MINIO_ACCESS_KEY=REPLACE_RANDOM_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_LONG_RANDOM_VALUE
JWT_SECRET=REPLACE_LONG_RANDOM_VALUE
UPLOAD_SIGNING_SECRET=REPLACE_DIFFERENT_LONG_RANDOM_VALUE
CLOUDFLARE_CALLS_APP_ID=REPLACE_SFU_APP_ID
CLOUDFLARE_CALLS_APP_SECRET=REPLACE_SFU_APP_SECRET
CLOUDFLARE_CALLS_TURN_KEY_ID=REPLACE_TURN_KEY_ID
CLOUDFLARE_CALLS_TURN_API_TOKEN=REPLACE_TURN_TOKEN
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_PRIVATE_TUNNEL_TOKEN
