# ==========================================
# Coturn 独立容器环境变量配置示例
# 部署时请复制为 .env：cp .env.example .env
# ==========================================

# 1. 动态凭据共享密钥 (与 Tescord 主服务端 .env 中的 TURN_SECRET 保持完全一致)
# 可通过执行 `openssl rand -hex 32` 生成
TURN_SECRET=tescord-standalone-turn-secret-change-me

# 2. 鉴权领域 (Realm)
TURN_REALM=tescord.local

# 3. 服务器外部公网 IP (若通过启动参数注入，可选)
# EXTERNAL_IP=203.0.113.10
