# Copy to docker/.env.production. Replace every value before starting Compose.
SITE_HOST=tescord.example.com
TURN_HOST=turn.example.com
PUBLIC_IP=203.0.113.10
DATABASE_URL=postgresql://tescord:REPLACE_POSTGRES_PASSWORD@postgres:5432/tescord
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_LONG_RANDOM_VALUE
MINIO_ACCESS_KEY=REPLACE_RANDOM_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_LONG_RANDOM_VALUE
JWT_SECRET=REPLACE_LONG_RANDOM_VALUE
UPLOAD_SIGNING_SECRET=REPLACE_DIFFERENT_LONG_RANDOM_VALUE
TURN_SECRET=REPLACE_ANOTHER_LONG_RANDOM_VALUE
LIVEKIT_API_KEY=REPLACE_ALPHANUMERIC_API_KEY
LIVEKIT_API_SECRET=REPLACE_LONG_RANDOM_VALUE
