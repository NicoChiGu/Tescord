FROM docker.io/library/node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /app
COPY . .
ARG VITE_VOICE_ENGINE=livekit
ENV VITE_VOICE_ENGINE=${VITE_VOICE_ENGINE}
RUN pnpm --filter @tescord/web... --filter @tescord/server... install --frozen-lockfile
RUN pnpm --filter @tescord/types build && pnpm --filter @tescord/web build

FROM docker.io/library/nginx:1.27.2-alpine
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY --chmod=755 docker/nginx-resolver.envsh /docker-entrypoint.d/15-resolver.envsh
