server {
    listen 80;
    server_name _;
    client_max_body_size 50m;
    resolver ${PODMAN_DNS} valid=5s ipv6=off;

    location = /healthz { access_log off; return 200 "ok"; }
    location ~ ^/(api|gateway|attachments|public-assets)(/|$) {
        set $api_upstream server:3001;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
    location ^~ /uploads/ { return 404; }
    # ONNX Runtime imports this module dynamically. NGINX's default MIME
    # table in the pinned image does not label .mjs as JavaScript.
    location ^~ /ort/ {
        root /usr/share/nginx/html;
        types {
            application/javascript mjs;
            application/wasm wasm;
        }
        try_files $uri =404;
    }
    # Model and worklet files must never resolve to the SPA HTML shell.
    location ^~ /models/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
    }
    location ^~ /rnnoise/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
    }
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
