{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["packages/audio-dsp/**"],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_PROVIDER",
        "GITHUB_REPOSITORY",
        "UPDATE_SIGNING_PUBLIC_KEY_BASE64",
        "BUILD_TARGET",
        "TESCORD_SERVER_URL",
        "TESCORD_GATEWAY_URL",
        "TESCORD_LIVEKIT_URL",
        "VITE_API_URL",
        "VITE_GATEWAY_URL",
        "VITE_LIVEKIT_URL",
        "VITE_VOICE_ENGINE"
      ],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
