# Tescord 环境变量配置示例

# 端口配置
PORT=3001
HOST=0.0.0.0

# JWT 鉴权密钥
# 生产环境必须替换为至少 32 字节的随机值
JWT_SECRET=replace-with-random-secret
CORS_ORIGINS=https://tescord.example.com

# 数据库 (SQLite；相对路径以 apps/server/prisma 为基准)
DATABASE_URL=file:./dev.db

# 缓存与 Pub/Sub (Redis)
REDIS_URL=redis://localhost:6379

# LiveKit SFU 媒体服务
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecret

# 自建 Coturn。生产环境必须使用公网可达主机和随机密钥。
TURN_HOST=127.0.0.1
TURN_PORT=3478
TURN_SECRET=replace-with-random-turn-secret
ALLOW_PUBLIC_STUN=false

# 本地附件短期上传/下载授权签名（生产环境必须使用独立随机值）
UPLOAD_SIGNING_SECRET=replace-with-long-random-upload-secret

# MinIO 对象存储
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=tescord-assets
