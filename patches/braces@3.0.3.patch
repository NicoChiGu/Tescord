diff --git a/lib/validate-depth.js b/lib/validate-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..5d98733cd9955678bc491f368123f460819dfe99
--- /dev/null
+++ b/lib/validate-depth.js
@@ -0,0 +1,24 @@
+'use strict';
+
+// Bound every recursive AST walker, including callers that provide their own AST.
+// Parent/prev links are intentionally excluded: braces ASTs contain back links.
+const MAX_DEPTH = 100;
+
+const validateDepth = ast => {
+  const stack = [{ node: ast, depth: 0 }];
+  const seen = new WeakSet();
+  while (stack.length) {
+    const { node, depth } = stack.pop();
+    if (depth > MAX_DEPTH) {
+      throw new SyntaxError(`Brace pattern exceeds maximum AST depth (${MAX_DEPTH})`);
+    }
+    if (!node || typeof node !== 'object') continue;
+    if (seen.has(node)) throw new SyntaxError('Brace AST must not contain shared or cyclic nodes');
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) stack.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
+
+module.exports = { MAX_DEPTH, validateDepth };
